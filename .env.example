ConnectionStrings__MongoDB=mongodb://localhost:27017
MongoDB__Database=hrmdb
Auth__JwtKey=your-super-secret-jwt-key-at-least-32-characters-long
Auth__Issuer=HrmApi
Auth__Audience=HrmApi
